# Endereço público do Sibrax. Normalmente não precisa alterar.
SIBRAX_URL=https://emissor.sibrax.com.br/app/entrar

# Usuário compartilhado do setor fiscal.
SIBRAX_USUARIO=

# Cole a senha depois do sinal de igual. Não use aspas.
SIBRAX_SENHA=

# Nome completo ou CNPJ da empresa que deve ser escolhida na primeira tela.
SIBRAX_EMPRESA=

# Tempo máximo para o Sibrax gerar o lote: 900 segundos = 15 minutos.
SIBRAX_TIMEOUT_SEGUNDOS=900

